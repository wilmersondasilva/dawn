# ---- Shopify (Dev Dashboard custom app, client credentials grant) ----
SHOPIFY_STORE=grand-st-development            # store subdomain (SHOPIFY_STORE_DOMAIN=<store>.myshopify.com also accepted)
SHOPIFY_CLIENT_ID=                            # from the app in the customer's Dev Dashboard
SHOPIFY_CLIENT_SECRET=                        # from the app in the customer's Dev Dashboard
SHOPIFY_API_VERSION=2026-07                   # Admin GraphQL version (latest stable when this was written)
STAGING_THEME_NAME=Staging                    # exact name of the unpublished theme connected to the staging branch

# ---- GitHub (fine-grained PAT scoped to this one repo: Contents rw, Pull requests rw, Metadata r) ----
GITHUB_OWNER=wilmersondasilva                 # repo owner
GITHUB_REPO=dawn                              # repo name
GITHUB_TOKEN=                                 # fine-grained personal access token from the agency service account
GITHUB_LIVE_BRANCH=main                       # branch connected to the published theme
GITHUB_STAGING_BRANCH=staging                 # branch connected to the "Staging" theme

# ---- MCP server ----
MCP_PATH_SECRET=                              # >=24 URL-safe chars; endpoint is /mcp/<secret>. Generate: openssl rand -base64 36 | tr '+/' '-_'
PORT=3000                                     # HTTP port to listen on
THEME_WRITE_MODE=shopify                      # shopify = themeFilesUpsert to Staging theme; github = commit to staging branch (use if ACCESS_DENIED)
STAGING_RESET_STRATEGY=force                  # force = reset staging to main before each draft; merge = merge main into staging (no force-push)
SYNC_TIMEOUT_SECONDS=120                      # how long to wait for Shopify's GitHub sync when verifying live/staging
CATALOG_TTL_SECONDS=300                       # section catalog cache lifetime
MAX_UPLOAD_MB=250                             # max video size the server will relay through a staged upload
AUDIT_LOG_FILE=                               # optional path; every mutation is also logged to stdout as JSON
